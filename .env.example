# ─── Backend API URL ──────────────────────────────────────────────────────────
# LOCAL DEV:  API_URL=http://localhost:5050/api
# PRODUCTION: API_URL=https://your-backend.vercel.app/api
API_URL=https://your-backend.vercel.app/api

# ─── Firebase Client SDK (PUBLIC values — safe in frontend code) ───────────────
# Get from: Firebase Console → Project Settings → General → Your apps → Web app
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abc123
